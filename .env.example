# ─── Base de données ──────────────────────────────────────────────────────────
# URL de connexion PostgreSQL.
# Neon (recommandé) : postgresql://user:pass@ep-xxx.region.neon.tech/dbname?sslmode=require
# PostgreSQL local  : postgresql://user:pass@localhost:5432/swimgen
DATABASE_URL=""

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Clé secrète pour signer les JWT de session (≥ 32 caractères aléatoires).
# Génère avec : openssl rand -base64 32
AUTH_SECRET=""

# ─── OAuth Google (optionnel) ─────────────────────────────────────────────────
# Si absent, la connexion par email/mot de passe reste fonctionnelle.
# Créer les credentials sur : https://console.cloud.google.com
#   → APIs & Services → Credentials → OAuth 2.0 Client IDs
#
# Redirect URIs à autoriser :
#   DEV  : http://localhost:3000/api/auth/callback/google
#   PROD : https://ton-domaine.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
