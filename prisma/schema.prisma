generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Level {
  debutant
  intermediaire
  avance
}

enum Stroke {
  crawl
  dos
  brasse
  papillon
  four_nages  // "4nages" n'est pas un identifiant SQL valide
}

enum Goal {
  endurance
  technique
  vitesse
  recuperation
}

enum Phase {
  warmup
  drills
  main
  cooldown
}

enum Intensity {
  easy
  moderate
  hard
  sprint
}

enum ExportTarget {
  garmin
  coros
  pdf
}

enum SessionStatus {
  planned
  completed
  cancelled
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  level        Level    @default(debutant)
  createdAt    DateTime @default(now())

  sessions   TrainingSession[]
  completed  CompletedLog[]
  scheduled  ScheduledSession[]
}

// ─── Séance d'entraînement ────────────────────────────────────────────────────
// Couvre à la fois les séances générées et les séances prêtes sauvegardées

model TrainingSession {
  id                String   @id @default(cuid())
  userId            String
  title             String
  subtitle          String?
  level             Level
  stroke            Stroke
  goal              Goal
  totalDistance     Int      // mètres
  estimatedDuration Int      // minutes
  poolLength        Int      @default(25)
  source            String   @default("generated") // "generated" | "ready"
  createdAt         DateTime @default(now())

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sets      TrainingSet[]
  completed CompletedLog[]
  scheduled ScheduledSession[]
}

// ─── Série dans une séance ────────────────────────────────────────────────────

model TrainingSet {
  id          String    @id @default(cuid())
  sessionId   String
  order       Int       // position dans la séance
  phase       Phase
  label       String
  repetitions Int
  distance    Int       // mètres par répétition
  stroke      String    // stocké en string pour gérer "4nages" et les variantes
  restSeconds Int       @default(0)
  intensity   Intensity @default(moderate)
  equipment   String?
  note        String?

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// ─── Log de séance complétée ──────────────────────────────────────────────────
// Une entrée = une séance réellement nagée (source du dashboard et de l'historique)

model CompletedLog {
  id              String       @id @default(cuid())
  userId          String
  sessionId       String
  completedAt     DateTime     @default(now())
  actualDuration  Int          // minutes réelles
  actualDistance  Int          // mètres réels
  notes           String?
  exportTarget    ExportTarget?
  exportedAt      DateTime?

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// ─── Calendrier ───────────────────────────────────────────────────────────────

model ScheduledSession {
  id           String        @id @default(cuid())
  userId       String
  sessionId    String
  scheduledFor DateTime      // date prévue
  status       SessionStatus @default(planned)
  createdAt    DateTime      @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
